<% layout("/layouts/boilerplate") %>
<div class="row">
  <div class="col-8 offset-3 mt-3">
    <h3>Listing Details:</h3>
  </div>
  <div class="card col-6 offset-2 show-card">
    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing-image">
    <div class="card-body">
      <p class="card-text">
        <b><%= listing.title %></b><br>
        <%= listing.description %><br>
        &#2547;<%= listing.price.toLocaleString("en-BD") %>/night<br>
        <%= listing.location %>
      </p>
      <div class="btns">
        <a href="/listing/<%= listing._id %>/edit" class="btn btn-danger edit-btn">Edit</a>
        <form method="POST" action="/listing/<%= listing._id %>?_method=DELETE" class="d-inline">
          <button class="btn btn-dark">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>