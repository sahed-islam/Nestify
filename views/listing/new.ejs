<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nestify</title>
</head>
<body>
    <h3> Create a new listing </h3>
    <form method="POST" action="/listing">
        <input name="listing[title]" placeholder="Enter title" type="text"><br><br>
        <textarea name="listing[description]" placeholder="Describe your place"></textarea><br><br>
        <input name="listing[image]" placeholder="Enter image URL/Link" type="text"><br><br>
        <input name="listing[price]" placeholder="Enter Price" type="number"><br><br>
        <input name="listing[location]" placeholder="Where are you at"><br><br>
        <button>Add</button>
    </form>
</body>
</html> 